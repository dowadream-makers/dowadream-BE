# 이 파일을 복사해 .env 를 만들면 ./gradlew bootRun 이 자동으로 읽습니다. .env 는 커밋하지 않습니다.
DATABASE_URL=jdbc:postgresql://localhost:5432/dowadream
DATABASE_USERNAME=dowadream
DATABASE_PASSWORD=dowadream
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 공공데이터포털 Decoding 인증키 (docs/backend-roadmap.md 1장)
PUBLIC_DATA_KEY=
# true면 서버 시작 직후 공공데이터 동기화를 한 번 실행 (평소엔 매일 04:00)
SYNC_ON_STARTUP=false
